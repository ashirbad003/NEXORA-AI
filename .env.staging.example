# ==============================================================================
# NEXORA AI - Staging Environment Configuration Template
# Environment: STAGING (Isolated Pre-Production Validation)
# ==============================================================================

# Application Environment
APP_ENV=staging
APP_NAME="NEXORA AI [STAGING]"
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=staging-secret-key-32bytes-minimum-isolated-non-production

# Server Configuration (Dedicated Staging Ports)
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Authentication & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Argon2id Parameters (RFC 9106 recommended profile)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Database Configuration (Dedicated PostgreSQL Staging Target)
# Format: postgresql+asyncpg://nexora_staging_app:staging_secret_pw@127.0.0.1:5432/nexora_staging
# Isolated local fallback for offline staging runs:
DATABASE_URL=sqlite+aiosqlite:///./nexora_staging.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./nexora_staging_test.db

# AI Provider Configuration
# Supported providers: local | mock | gemini
AI_PROVIDER=local
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=10

# Coding Arena Sandbox Configuration
# Set to 'container_isolated' when Docker engine is active; 'disabled' enforces fail-closed safety
SANDBOX_MODE=disabled
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_MAX_OUTPUT_BYTES=65536
