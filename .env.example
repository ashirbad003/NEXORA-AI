# ==============================================================================
# NEXORA AI - Environment Configuration Template
# Standard: Copy to .env and configure values. NEVER commit actual .env files.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
APP_NAME="NEXORA AI"
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Argon2id Parameters (RFC 9106 recommended profile)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Database Configuration
# Default local test fallback: SQLite async
# DATABASE_URL=sqlite+aiosqlite:///./nexora_dev.db
#
# Dedicated PostgreSQL 17 Target (Least-Privileged Role):
# Format: postgresql+asyncpg://<app_user>:<app_password>@127.0.0.1:5432/nexora_dev
DATABASE_URL=sqlite+aiosqlite:///./nexora_dev.db

# AI Provider Configuration
# Supported providers: local | gemini | mock
AI_PROVIDER=local
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=10

# Coding Arena Sandbox Configuration
# MUST be 'disabled' unless container/gVisor runtime is active
SANDBOX_MODE=disabled
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_MAX_OUTPUT_BYTES=65536
